{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoreTools",
  "version": "1.2.5",
  "identifier": "io.coretools.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CoreTools",
        "width": 1100,
        "height": 760,
        "minWidth": 780,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage"],
    "category": "DeveloperTool",
    "publisher": "JDG Initiates",
    "copyright": "© 2026 JDG Initiates",
    "shortDescription": "Offline file diff & Kubernetes YAML optimizer",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "headerImage": "installer/nsis-header.bmp",
        "template": "installer/installer.nsi",
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://raw.githubusercontent.com/jaychandra1/artifacts/main/coretools/releases/updater.json",
        "https://github.com/jaychandra1/artifacts/releases/download/coretools-latest/updater.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
