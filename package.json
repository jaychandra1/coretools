{
  "name": "coretools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight, fully offline desktop toolkit: file diff & merge + Kubernetes YAML optimizer.",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:web": "vite build --mode web && node scripts/build-web.mjs",
    "icon": "node scripts/generate-icon.mjs && tauri icon src-tauri/app-icon.png && node scripts/generate-installer-art.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "diff": "^9.0.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/diff": "^7.0.2",
    "@types/qrcode": "^1.5.6",
    "svelte": "^5.46.4",
    "svelte-check": "^4.7.3",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
