{
  "name": "coretools",
  "version": "1.2.6",
  "private": true,
  "type": "module",
  "description": "Lightweight, fully offline desktop toolkit: file diff & merge + Kubernetes YAML optimizer.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "preversion": "node scripts/changelog.mjs release --dry-run",
    "version": "node scripts/sync-version.mjs --git-add && node scripts/changelog.mjs release --git-add",
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:web": "vite build --mode web && node scripts/build-web.mjs",
    "icon": "node scripts/generate-icon.mjs && tauri icon src-tauri/app-icon.png && node scripts/generate-installer-art.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@tauri-apps/api": "^2.0.0",
    "diff": "^9.0.0",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "jmespath": "^0.16.0",
    "jsonpath-plus": "^10.4.0",
    "jsonrepair": "^3.15.0",
    "jsqr": "^1.4.0",
    "monaco-editor": "~0.53.0",
    "qrcode": "^1.5.4",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/diff": "^7.0.2",
    "@types/jmespath": "^0.15.2",
    "@types/qrcode": "^1.5.6",
    "fake-indexeddb": "^6.2.5",
    "svelte": "^5.46.4",
    "svelte-check": "^4.7.3",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
